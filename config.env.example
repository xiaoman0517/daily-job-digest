# ============================================================
# 每日远程岗位智能推送 - 配置模板
# 使用方法：
#   1. 复制本文件为 config.env：  copy config.env.example config.env
#   2. 填写下方真实值（API Key、邮箱等敏感信息，切勿提交到版本库）
#   3. 配置优先级：系统环境变量 > 本文件 > 代码内置默认值
# ============================================================

# ---------------- DeepSeek API ----------------
# 在 https://platform.deepseek.com 创建 API Key
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat
# 每批打分数量（调大省钱但单批慢，调小更稳）
DEEPSEEK_BATCH_SIZE=15
# 单次请求超时（秒）
DEEPSEEK_TIMEOUT=90
# 单批失败重试次数
DEEPSEEK_MAX_RETRIES=2

# ---------------- 邮件 (SMTP) ----------------
# QQ邮箱:   smtp.qq.com   465 (需开启SMTP服务，密码填"授权码")
# 163邮箱:  smtp.163.com  465 (同上，填授权码)
# Gmail:    smtp.gmail.com 465 (需"应用专用密码")
# 企业微信/Outlook: smtp.exmail.qq.com 465
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# 收件人邮箱，多个用英文逗号分隔
MAIL_TO=
# 发件人显示名称
MAIL_SENDER_NAME=每日远程岗位推荐

# ---------------- 抓取范围 ----------------
# RemoteOK 标签（逗号分隔）。按你的技术栈修改，标签越多请求越慢，建议 5~10 个。
REMOTEOK_TAGS=python,javascript,typescript,backend,frontend,fullstack,machine-learning,data,devops
# WeWorkRemotely RSS（逗号分隔）
WWR_FEEDS=https://weworkremotely.com/categories/remote-programming-jobs.rss,https://weworkremotely.com/categories/remote-back-end-programming-jobs.rss,https://weworkremotely.com/categories/remote-full-stack-programming-jobs.rss,https://weworkremotely.com/categories/remote-data-jobs.rss
# 回看最近多少小时的新岗位（Jobicy / HN / WWR 使用；RemoteOK 与 Remotive 见下方独立窗口）
HOURS_LOOKBACK=24
# RemoteOK/Remotive 的列表多为"常驻/重发"岗位，原始发布日期偏旧，24h 窗口会误杀全部，
# 故用更长回看窗口（填 0 = 不过滤时间，靠已推送历史去重避免重复）。
REMOTEOK_LOOKBACK_HOURS=168
REMOTIVE_LOOKBACK_HOURS=168
# Jobicy/Remotive 等新聚合源的关键词预过滤（逗号分隔，命中标题/描述/标签任一即保留）。
# 留空则默认按 REMOTEOK_TAGS 过滤；两者都为空则不过滤（会多花打分 token）。
SEARCH_KEYWORDS=ai,llm,agent,rag,python,machine-learning,deep-learning,computer-vision,pytorch,data,backend,frontend,fullstack,cloud,aws,devops,software
# 启用的数据源（可裁剪/排序）：remoteok / wwr / hn / jobicy / remotive
# 例：WWR 在国内网络常被 Cloudflare 整体拦截(403)，用不到可去掉 wwr。
ENABLED_SOURCES=remoteok,wwr,hn,jobicy,remotive
# 每天推送 Top N 个岗位
TOP_N=30
# 匹配度门槛（低于此分不推送）
SCORE_THRESHOLD=60

# ---------------- 技能画像 ----------------
# 用于 DeepSeek 打分的技能背景文件路径。
# 新用户：先 copy skill_profile.txt.example skill_profile.txt，再编辑成自己的真实背景；
# 已有画像文件：改成你自己的文件路径即可。留空则使用内置通用模板（不推荐）。
SKILL_PROFILE_FILE=skill_profile.txt

# ---------------- 其他 ----------------
# 邮件中显示时间的时区（IETF 时区名）
TIMEZONE=Asia/Shanghai
# 已推送岗位历史记录文件
SENT_HISTORY_FILE=sent_job_ids.json
# 日志目录
LOG_DIR=logs
# 当今天没有达标岗位时，是否仍发送一封说明邮件（true/false）
SEND_EMPTY_DIGEST=false
# 是否使用系统代理（requests 会自动读取 Windows 系统代理设置）。
# 若你的代理（Clash/V2Ray 等）未开启导致连接失败，可设为 false 直连。
USE_SYSTEM_PROXY=true
